{
  "domain": "crm",
  "display_name": "Customer Relationship Management",
  "description": "Leads, contacts (including students' parents and guardians), deals and activities.",
  "entities": {
    "leads": {
      "description": "Prospects not yet converted to customers",
      "id_prefix": "LEAD", "seed_count": 12,
      "fields": {
        "id": "string",
        "full_name": "person",
        "company": {"type": "string", "examples": ["Acme Corp", "Globex Retail", "Initech Foods", "Umbrella Clinics", "Stark Fitness", "Wayne Hotels", "Hooli Schools", "Pied Piper Labs"]},
        "email": "email",
        "source": {"type": "string", "enum": ["website", "referral", "event", "cold call", "social"]},
        "status": {"type": "string", "enum": ["new", "contacted", "qualified", "lost"]},
        "estimated_value": {"type": "number", "min": 1000, "max": 80000},
        "created_date": {"type": "date", "range_days": [-90, 0]}
      }
    },
    "contacts": {
      "description": "People we keep in touch with. Parents/guardians are linked to a student via student_id.",
      "id_prefix": "CON", "seed_count": 10,
      "fields": {
        "id": "string",
        "full_name": {"type": "person", "required": true},
        "email": "email",
        "phone": "phone",
        "relation": {"type": "string", "enum": ["parent", "guardian", "customer", "partner"], "weights": [6, 2, 1, 1]},
        "student_id": {"type": "string", "ref": "sis.students", "unique": true, "only_if": {"relation": ["parent", "guardian"]}, "description": "Linked student (sis.students.id) for parents/guardians"},
        "preferred_channel": {"type": "string", "enum": ["email", "phone", "sms"]},
        "city": {"type": "string", "examples": ["Springfield", "Riverton", "Lakeside", "Fairview"]}
      }
    },
    "deals": {
      "description": "Sales opportunities in the pipeline",
      "id_prefix": "DEAL", "seed_count": 8,
      "fields": {
        "id": "string",
        "name": {"type": "string", "unique": true, "examples": ["Annual software renewal", "Campus Wi-Fi upgrade", "POS rollout - 3 stores", "Support plan upgrade", "Bulk furniture order", "Training package", "Data migration project", "Hardware refresh"]},
        "contact_id": {"type": "string", "ref": "crm.contacts"},
        "stage": {"type": "string", "enum": ["prospecting", "proposal", "negotiation", "won", "lost"]},
        "amount": {"type": "number", "min": 2000, "max": 150000},
        "close_date": {"type": "date", "range_days": [-30, 60]},
        "owner": "person"
      }
    },
    "activities": {
      "description": "Calls, emails, meetings and notes logged against contacts",
      "id_prefix": "ACT", "seed_count": 15,
      "fields": {
        "id": "string",
        "type": {"type": "string", "enum": ["call", "email", "meeting", "note"]},
        "subject": {"type": "string", "examples": ["Follow-up on proposal", "Tuition payment reminder", "Intro call", "Pricing questions", "Parent-teacher meeting request", "Contract review", "Demo scheduled"]},
        "contact_id": {"type": "string", "ref": "crm.contacts"},
        "deal_id": {"type": "string", "ref": "crm.deals"},
        "date": {"type": "date", "range_days": [-30, 0]},
        "outcome": {"type": "string", "enum": ["completed", "no answer", "rescheduled", "positive", "negative"]}
      }
    }
  }
}
