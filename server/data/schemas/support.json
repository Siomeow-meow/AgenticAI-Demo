{
  "domain": "support",
  "display_name": "Customer Support",
  "description": "Tickets, support agents, SLA targets and knowledge-base articles.",
  "entities": {
    "tickets": {
      "description": "Customer support requests",
      "id_prefix": "TCK", "seed_count": 15,
      "fields": {
        "id": "string",
        "subject": {"type": "string", "required": true, "examples": ["Cannot log in to portal", "Invoice total mismatch", "Shipment delayed", "Damaged item on delivery", "POS terminal offline", "Grades not showing for student", "Password reset email missing", "Refund not received", "Report export fails", "Wrong item shipped", "Payroll slip incorrect", "Kiosk card reader error", "Need bulk discount", "API timeout on orders", "Duplicate charge on card"]},
        "customer_name": {"type": "string", "examples": ["Acme Corp", "Globex Retail", "Initech Foods", "Umbrella Clinics", "Stark Fitness", "Wayne Hotels", "Hooli Schools"]},
        "severity": {"type": "string", "enum": ["low", "medium", "high", "critical"], "weights": [4, 5, 3, 2]},
        "status": {"type": "string", "enum": ["open", "in_progress", "resolved", "closed"]},
        "agent_id": {"type": "string", "ref": "support.agents"},
        "channel": {"type": "string", "enum": ["email", "phone", "chat", "portal"]},
        "created_at": {"type": "datetime", "range_days": [-30, 0]}
      }
    },
    "agents": {
      "description": "Support team members",
      "id_prefix": "AGT", "seed_count": 5,
      "fields": {
        "id": "string",
        "full_name": "person",
        "team": {"type": "string", "enum": ["Tier 1", "Tier 2", "Billing"]},
        "email": "email",
        "skill_level": {"type": "string", "enum": ["junior", "mid", "senior"]},
        "active": "boolean",
        "open_tickets": {"type": "integer", "min": 0, "max": 12}
      }
    },
    "slas": {
      "description": "Response and resolution targets per severity",
      "id_prefix": "SLA", "seed_count": 4,
      "fields": {
        "id": "string",
        "severity": {"type": "string", "unique": true, "examples": ["critical", "high", "medium", "low"]},
        "first_response_hours": {"type": "integer", "unique": true, "examples": [1, 4, 24, 48]},
        "resolution_hours": {"type": "integer", "unique": true, "examples": [8, 48, 120, 360]},
        "escalate_to": {"type": "string", "unique": true, "examples": ["Support Lead + Engineering on-call", "Support Lead", "none", "none"]},
        "business_hours_only": {"type": "boolean", "unique": true, "examples": [false, true, true, true]}
      }
    },
    "kb_articles": {
      "description": "Knowledge-base articles for agents and customers",
      "id_prefix": "KB", "seed_count": 8,
      "fields": {
        "id": "string",
        "title": {"type": "string", "unique": true, "examples": ["Resetting your portal password", "Reconnecting an offline POS terminal", "How refunds are processed", "Exporting reports to CSV", "Fixing kiosk card reader errors", "Understanding your invoice", "Viewing student grades", "Escalating a critical ticket"]},
        "category": {"type": "string", "enum": ["account", "pos", "billing", "reports", "sis"]},
        "author_agent_id": {"type": "string", "ref": "support.agents"},
        "views": {"type": "integer", "min": 20, "max": 3000},
        "helpful_pct": {"type": "integer", "min": 55, "max": 98},
        "updated_date": {"type": "date", "range_days": [-120, 0]}
      }
    }
  }
}
