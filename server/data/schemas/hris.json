{
  "domain": "hris",
  "display_name": "Human Resources Information System",
  "description": "Employees, departments, payroll runs and leave requests.",
  "entities": {
    "employees": {
      "description": "Staff records",
      "id_prefix": "EMP", "seed_count": 15,
      "fields": {
        "id": "string",
        "full_name": {"type": "person", "required": true},
        "department_id": {"type": "string", "ref": "hris.departments"},
        "job_title": {"type": "string", "examples": ["Software Engineer", "Accountant", "Account Executive", "HR Generalist", "Support Specialist", "Operations Analyst", "Team Lead"]},
        "salary": {"type": "number", "min": 35000, "max": 150000, "decimals": 0},
        "hire_date": {"type": "date", "range_days": [-3000, -30]},
        "status": {"type": "string", "enum": ["active", "on_leave", "terminated"], "weights": [12, 2, 1]},
        "email": "email"
      }
    },
    "departments": {
      "description": "Organisational units",
      "id_prefix": "DEP", "seed_count": 5,
      "fields": {
        "id": "string",
        "name": {"type": "string", "unique": true, "examples": ["Engineering", "Sales", "Finance", "People Ops", "Operations"]},
        "head": "person",
        "annual_budget": {"type": "number", "min": 200000, "max": 2500000, "decimals": 0},
        "location": {"type": "string", "examples": ["HQ Floor 3", "HQ Floor 5", "Remote", "Branch Office"]},
        "headcount_target": {"type": "integer", "min": 4, "max": 40}
      }
    },
    "payroll": {
      "description": "Monthly payroll records per employee",
      "id_prefix": "PAY", "seed_count": 20,
      "fields": {
        "id": "string",
        "employee_id": {"type": "string", "ref": "hris.employees", "required": true},
        "period": {"type": "string", "enum": ["2026-08", "2026-09"]},
        "gross_pay": {"type": "number", "min": 2900, "max": 12500},
        "tax_withheld": {"type": "number", "min": 300, "max": 2800},
        "status": {"type": "string", "enum": ["paid", "pending"], "weights": [4, 1]},
        "pay_date": {"type": "date", "range_days": [-50, 0]}
      }
    },
    "leave_requests": {
      "description": "Time-off requests",
      "id_prefix": "LV", "seed_count": 12,
      "fields": {
        "id": "string",
        "employee_id": {"type": "string", "ref": "hris.employees", "required": true},
        "leave_type": {"type": "string", "enum": ["annual", "sick", "parental", "unpaid"]},
        "start_date": {"type": "date", "range_days": [-30, 45]},
        "days": {"type": "integer", "min": 1, "max": 10},
        "status": {"type": "string", "enum": ["pending", "approved", "rejected"]},
        "reason": {"type": "string", "examples": ["Family trip", "Medical appointment", "Personal matters", "Wedding", "Recovery"]}
      }
    }
  }
}
