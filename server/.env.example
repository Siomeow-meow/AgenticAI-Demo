# ---------------------------------------------------------------
# Copy this file to .env and fill in your key.
# Any OpenAI-compatible provider works: change these 3 lines only.
# ---------------------------------------------------------------

# Alibaba DashScope / Model Studio.
# Mainland China account:  https://dashscope.aliyuncs.com/compatible-mode/v1
# International account:   https://dashscope-intl.aliyuncs.com/compatible-mode/v1
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=your-key-here
LLM_MODEL=qwen3.6-35b-a3b

# Optional: a separate model for analyze_image if LLM_MODEL can't read images
# (e.g. qwen-vl-max). Leave blank to use LLM_MODEL for vision too.
VISION_MODEL=

# Qwen3-family models "think" by default; DashScope requires thinking OFF for
# non-streaming tool calls. Set to false for providers that reject the
# enable_thinking parameter (e.g. OpenAI).
LLM_DISABLE_THINKING=true

# Optional tuning
LLM_TEMPERATURE=0.2
AGENT_MAX_ITERATIONS=8
EMBED_MODEL=BAAI/bge-small-en-v1.5
